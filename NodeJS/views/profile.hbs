<div id="changePassPopup" class="login-popup" style="display: none;">
  <a href="#" class="close">&times;</a>
  <h4>Change Your Password</h4>
  <form id="changePassForm">
    <input type="password" id="currentPassword" class="current-password form-control" placeholder="Current Password" required/>
    <input type="password" id="newPassword" class="new-password form-control" placeholder="New Password" required/>
    <input type="password" id="confirmNewPassword" class="confirm-new-password form-control" placeholder="Confirm New Password" required/>
    <input type="button" id="changePasswordBtn" class="btn login" value="Change Password" />
  </form>
</div>



