<input type="file" id="profileImageInput" style="display: none;" accept="image/*">
<input type="file" id="coverImageInput" style="display: none;" accept="image/*">

<div id="managerCreatePopup" class="create-account-popup" style="display: none;">
  <a href="#" class="close">&times;</a>
  <h4>Create a User Account</h4>
  <form name="createUserM" action="create-account-success-manager" onsubmit="if (validateCreateUserM()){event.preventDefault(); checkCreateFromManager().then(valid => { if (valid) this.submit(); })} else return false" method="get">
    <input type="text" name="newUsername" class="form-control" placeholder="Username" required/>
    <input type="email" name="email" class="form-control" placeholder="Email" required/>
    <input type="text" name="displayName" class="form-control" placeholder="Display Name (Optional)"/>
    <input type="password" name="newPassword" class="form-control" placeholder="Password" required/>
    <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm Password" required/>
    <select name="accountType" class="form-control">
      <option value="member">Member</option>
      <option value="manager">Manager</option>
    </select>
    <input class="btn create-account" type="submit" value="Create" />
  </form>
</div>

<div id="deleteAccountPopup" class="login-popup" style="display: none;">
  <a href="#" class="close">&times;</a>
  <h4>Account Deletion</h4>
  <form id="deleteAccountForm" name="deleteAccount" action="delete-account" onsubmit="event.preventDefault(); checkDelete().then(valid => { if (valid) this.submit(); })" method="post">
    <input type="text" name="username" class="form-control" placeholder="Your username" required/>
    <input type="password" name="password" class="form-control" placeholder="Password" required/>
    <input id="delete-account-btn" class="btn login" type="submit" value="Delete" />
  </form>
</div>


<!-- Cover Start -->
<div class="cover-container" id="coverContainer">
  <div class="cover-overlay" id="coverOverlay"></div>
  <div class="cover-banner" id="coverBannerContainer"></div>
</div>

<div class="image-overlay" id="imageOverlay"></div>
<div div class="main-profile" id="main-profile">
  <div class="imageContainer" id="profileImageContainer">
    <img src="https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_1280.png" alt="" id="profileImage">
  </div>
  <div class="profile-details">
    <div class="main-info">
      <span id="roleTag" class="role">Manager</span>
      <div class="username-container">
        <div><h4 id="displayName" contenteditable="false">Epic Gamer</h4></div>
        <div><h2><span>@</span><span id="userName" contenteditable="false">EpicGamer</span></h2></div>
        
      </div>
      <div id="addDisplayContainer"></div>   
      <p id="userBio" contenteditable="false">Im just your average gamer. Im just your average gamer. Im just your average gamer. Im just your average gamer.</p>
    </div> 
    <div class="edit">
      <a href="#" id="editProfileBtn"><i id="editIcon" class="fa fa-pencil"></i></a>
    </div>
  </div>
</div>
