<div class="search-main-banner">
    <div class="search-page">
        <div class="search-container">
            <label for="searchOptions">Choose a search option:</label>
            <select id="searchOptions" onchange="showSearchForm(this.value)">
                <option value="">Select an Option</option>
                {{#if isManager}}
                <option value="accounts">Search Accounts</option>
                {{/if}}
                <option value="slots">Search Available Slots</option>
            </select>
        </div>

        <div id="searchMemberForm" class="search-form" style="display:none;">
            <form>
                <label for="memberName">Name:</label>
                <input type="text" id="memberName" name="memberName">
                
                <label for="memberId">ID:</label>
                <input type="text" id="memberId" name="memberId">
                
                <button type="button" onclick="submitMemberSearch()">Search Member</button>
            </form>
        </div>

        <div id="searchSlotsForm" class="search-form" style="display:none;">

            <!-- TO DO: 
                Add the following selections to be modified through js:
                - tier
                - preferred time_starts (or a window)
                - duration (optional maybe)
                - seat (??)
                - date (ofc) - year, month, day
            -->

            <div class="day-selection">
                <label for="tierFilter">Choose a Tier:</label>
                <select id="tierFilter" class="day-select">
                    <!-- Options will be populated by JavaScript (search.js) -->
                </select>
            </div>

            <div class="day-selection">
                <label for="time_startFilter">Choose a starting time:</label>
                <select id="time_startFilter" class="day-select">
                    <!-- Options will be populated by JavaScript (search.js) -->
                </select>
            </div>
            
            {{!-- <div class="day-selection">
                <label for="durationFilter">Choose a duration:</label>
                <select id="durationFilter" class="day-select">
                    <!-- Options will be populated by JavaScript (search.js) -->
                </select>
            </div> --}}

            <div class="day-selection">
                <label for="seatFilter">Choose a seat number:</label>
                <select id="seatFilter" class="day-select">
                    <!-- Options will be populated by JavaScript (search.js) -->
                </select>
            </div>

            <div class="day-selection">
                <label for="dateFilter">Choose a Date:</label>
                <select id="dateFilter" class="day-select">
                    <!-- Options will be populated by JavaScript (search.js) -->
                </select>
            </div>

            <button type="button" onclick="PopulateResultContainer()">Search</button>
        </div>

        <div id="availableSeats" class="seats-container" style="display:none;">
            <!-- Available seats will be dynamically inserted here -->
        </div>
        <br>
        <div id="searchResultsDiv" class="profile-reservations" style="display:none;">
            <div class="heading-section">
            <h4><em id="headingWhiteSearch">Available</em>  <access id="headingRedSearch">Slots</access></h4>
            </div>

            <div id="searchResult-container">
            <!-- Search results will be dynamically inserted here -->
            </div>
            
            <div id="paginationS" class="pagination">
                <i id="firstButtonS" class="fa fa-angles-left"></i>
                <i id="prevButtonS" class="fa fa-angle-left"></i>
                <span>Page <span id="currentPageS">1</span></span>
                <i id="nextButtonS" class="fa fa-angle-right"></i>
                <i id="lastButtonS" class="fa fa-angles-right"></i>
            </div>
        </div>

    </div>

    <div id="reservationForm" class="reservation-form search-page" style="display:none;">
        <form>
            <label for="name">Name:</label>
            <input type="text" id="name" name="name" required>
            
            <label for="timeFrom">Time From:</label>
            <input type="time" id="timeFrom" name="timeFrom" required>
            
            <label for="timeTo">Time To:</label>
            <input type="time" id="timeTo" name="timeTo" required>
            
            <button type="button" onclick="submitReservation()">Reserve</button>
        </form>
    </div>

    

</div>
