<div class="reserve-main-banner">
    <div class="reservation-container">
        <!-- Tier Selection -->


        <div class="row tier-selection">
            <div class="col-md-4 tier-option">
                <div class="tier-image-container">
                    <img src="assets/images/tier1.png" alt="Tier 1" class="img-fluid">
                    <div class="tier-label">Tier 1</div>
                </div>
            </div>
            <div class="col-md-4 tier-option">
                <div class="tier-image-container">
                    <img src="assets/images/tier2.png" alt="Tier 2" class="img-fluid">
                    <div class="tier-label">Tier 2</div>
                </div>
            </div>
            <div class="col-md-4 tier-option">
                <div class="tier-image-container">
                    <img src="assets/images/tier3.png" alt="Tier 3" class="img-fluid">
                    <div class="tier-label">Tier 3</div>
                </div>
            </div>
        </div>


        <div class="tier-selection">
            <label for="tierSelect">Choose a Tier:</label>
            <select id="tierSelect" class="tier-select" onchange="validateSelection()">
                <option value="">Select a Tier</option>
                <option value="tier1">Tier 1</option>
                <option value="tier2">Tier 2</option>
                <option value="tier3">Tier 3</option>
            </select>
        </div>

        <!-- Day Selection -->
        <div class="day-selection">
            <label for="daySelect">Choose a Day:</label>
            <select id="daySelect" class="day-select">
                <!-- Options will be populated by JavaScript -->
            </select>
        </div>

        <!-- Seats Container -->
        <div id="seatsContainer" class="seats-container">
            <!-- JavaScript will populate this area with seat buttons -->
        </div>

        <!-- Time Blocks Container -->
        <div id="timeBlocksContainer" class="time-blocks-container" style="display:none;">
            <!-- JavaScript will populate this area with time block buttons -->
        </div>

        <!-- Reservation Form -->
        <div id="reservationForm" class="reservation-form" style="display:none;">
            <form name="reservationForm" action="reserve-form" method="post" onsubmit="return submitReservation()">
            <div class="reservation-form-fields-container" style="display:block;">
                <label for="name">Name:</label>
                <input type="text" id="reservationName" name="name" placeholder="Username" readonly>
                
                <label for="email">Email:</label>
                <input type="email" id="reservationEmail" name="email" placeholder="Email" readonly>
            </div>
            <div class="reservation-form-buttons-container">
                <input type="submit" value="Reserve">
                <button type="button" id="deleteButtonRes" style="display:none;">Delete</button>
            </div>
            {{!-- hidden input utility for selected tier, day, time/s, #seat --}}
            <input type="hidden" name="selectedTier">
            <input type="hidden" name="selectedDay">
            <input type="hidden" name="time">
            <input type="hidden" name="seat">
            <input type="hidden" name="reserveManager">
            <input type="hidden" name="reserverName">
            <input type="hidden" name="reserverEmail">
            <input type="hidden" name="submitType" value="reserve">
            </form>
        </div>
    </div>

    {{!-- <!-- Confirmation Popup -->
    <div id="confirmationPopup" class="confirmation-popup" style="display:none;">
        <p>Your reservation is confirmed!</p>
        <button onclick="closePopup()">Close</button>
    </div> --}}
</div>

