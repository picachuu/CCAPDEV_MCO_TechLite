<!-- Preload Start-->
{{> preload}}
<!-- Preload End-->

<!-- Header Start-->
{{> header}}
<!-- Header End -->

<div class="reservation-management">
    <h2>Manage Reservation</h2>
    <form id="reservationForm">
        <div class="form-group">
            <label for="userName">Name of User</label>
            <input type="text" id="userName" name="userName" required>
        </div>
        <div class="form-group">
            <label for="userEmail">Email</label>
            <input type="email" id="userEmail" name="userEmail" required>
        </div>
        <!-- Tier Selector -->
        <div class="form-group">
            <label for="tierSelect">Tier Selected:</label>
            <select id="tierSelect" class="tier-select" disabled>
                <option value="tier1">Tier 1</option>
                <option value="tier2">Tier 2</option>
                <option value="tier3">Tier 3</option>
            </select>
        </div>     
        <!-- Date Selector -->
        <div class="form-group">
            <label for="daySelect">Choose a Date:</label>
            <select id="daySelect" class="day-select">
                <!-- Options will be populated by JavaScript -->
            </select>
        </div>

        <!-- Seats Container -->
        <div id="seatsContainer" class="seats-container">
            <!-- JavaScript will populate this area with seat buttons -->
        </div>

        <!-- User Time Blocks Container -->
        <div id="userTimeBlocksContainer" class="time-blocks-container" style="display:none;">
            <!-- JavaScript will populate this area with time block buttons -->
        </div>

        <!-- Time Blocks Container -->
        <div id="timeBlocksContainer" class="time-blocks-container" style="display:none;">
            <!-- JavaScript will populate this area with time block buttons -->
        </div>

        <button type="button" class="submit-btn">Update Reservation</button>
        <button type="button" class="submit-btn">Delete Reservation</button>
    </form>
</div>


<!-- Contact Start -->
{{> contact}}
<!-- Contact End -->
{{> footer}}