<header class="header-area header-sticky">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav class="main-nav">
                    <a href="main" method="get" class="logo">
                        <img src="assets/images/logo.png" alt="">
                    </a>
                    <!-- Menu Start -->
                    <!-- Popup Form (Hidden by default) -->
                    <div id="loginPopup" class="login-popup" style="display: none;">
                      <a href="" class="close">&times;</a>
                      <h4>Log In to Your Account</h4>
                      <form name="login" action="login-account" onsubmit="event.preventDefault(); checkLogin().then(valid => { if (valid) this.submit(); })" method="post">
                        <input type="text" name="username" class="username form-control" placeholder="Username" required/>
                        <input type="password" name="password" class="password form-control" placeholder="Password" required/>
                        <p>Don't have an account? <a href="#" id="createAccountLink">Create here</a></p>
                        <input id="confirm-login" class="btn login" type="submit" value="Login" />
                      </form>
                    </div>
                    <div id="createAccountPopup" class="create-account-popup" style="display: none;">
                      <a href="#" class="close">&times;</a>
                      <h4>Create an Account</h4>  {{!-- mco3 funcitonality --}}
                      <form name="createUser" action="create-account-success" onsubmit="if (validateCreateUser()){event.preventDefault(); checkCreateUser().then(valid => { if (valid) this.submit(); })} else return false" method="get">
                        <input type="text" name="newUsername" class="form-control" placeholder="Username" required/>
                        <input type="email" name="email" class="form-control" placeholder="Email" required/>
                        <input type="text" name="displayName" class="form-control" placeholder="Display Name (Optional)"/>
                        <input type="password" name="newPassword" class="form-control" placeholder="Password" required/>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm Password" required/>
                        <p>Already have an account? <a href="#" id="loginLink">Log-in here</a></p>
                        <input class="btn create-account" type="submit" value="Create Account" />
                      </form>
                    </div>
                    <div id="confirmationPopup" class="confirmation-popup" style="display: none;">
                      <a href="" class="close">&times;</a>
                      <h4>Confirm Action</h4>
                      <button id="confirm-confirmation" class="btn confirmation">Confirm</button>
                      <button id="cancel-confirmation" class="btn confirmation">Cancel</button>
                    </div>
                    <ul class="nav">
                        <li><a href="main" method='get' class="" id="navbarHome">Home</a></li>
                        <li><a href='reserve' method='get' id="navbarReserve">Reserve</a></li>
                        <li><a href="search" method='get' id="navbarSearch">Search</a></li>
                        <li><a href="services" method='get' id="navbarServices">Services</a></li>
                        <li><a href="#" id="loginBtn" class="login-button">Log In</a></li>
                        <li><a href="profile" method="get" id="navbarProfile" >Profile <img src="assets/images/profile.jpg" alt="" id="navbarProfileImage"></a></li>
                        {{!-- comment one of the login or profile to fit (uncommenting just makes an access to profile) [during login validation testing] --}}
                        
                    </ul>
                    <a class='menu-trigger'>
                        <span>Menu</span>
                    </a>
                    <!-- Menu End -->
                </nav>
            </div>
        </div>
    </div>
  </header>